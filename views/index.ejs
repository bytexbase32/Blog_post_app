<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog website</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <!-- include partial header here -->
    </header>
   
    <main>
    <h1>Your Daily Post</h1>
    <form action="/" method="post">
      <label for="title">Title</label>
      <input type="text" name="title" id="title" required />

      <label for="content">Content</label>
      <textarea name="content" id="content" required placeholder="Write your blog post."></textarea>

      <input type="submit" value="Save Post" />
    </form>

    <section id="posts">
        <div class="posts-container">
            <% if (posts && posts.length > 0) {%>
            <ul>
                <% posts.forEach(post => {%>
                    <li>
                        <h3><a href="/post/<%= post.id %>"><%= post.title %></a></h3>
                        <p>
                            <%= post.content.substring(0,100) + "..." %>
                        </p>
                        <a href="/edit/<%= post.id %>" class="btn edit-btn">Edit</a>
                        <form action="/delete/<%= post.id %>" method="post" style="display:inline;">
                            <button type="submit"  class="btn delete-btn" onclick="return confirm('Are you sure you want to delete this post?');">Delete</button>
                        </form>

                    </li>
                <% }); %>
            </ul>
            <% } else { %>
            <p>No posts yet.</p>
            <% } %>
        </div>
    </section>
    </main>
    <footer>
        <!-- include partial footer here -->
    </footer>
</body>
</html>